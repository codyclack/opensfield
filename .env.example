# Every setting OpenSfield reads, shown with its default (details: the Settings table in README.md).
# A checklist, not a config file: the app does not load .env and `uv run` does not read it. Set the ones you
# need in your shell or your host's secret settings. Lines stay commented: an empty value is not the default
# (OPENSFIELD_MODE= stops the app, an empty number is an error). Never commit real keys.

# OPENSFIELD_MODE=mock
# OPENSFIELD_PARTNER=1
# OPENSFIELD_ACCESS_KEY=
# OPENSFIELD_MAX_JOBS=0
# OPENSFIELD_MAX_PENDING=20
# OPENSFIELD_MAX_UPLOAD_MB=512
# OPENSFIELD_JOB_TIMEOUT=900
# OPENSFIELD_JOBS_FILE=outputs/jobs.json
# OPENSFIELD_MOCK_DELAY=3
# COMFY_BASE_URL=http://127.0.0.1:8188
# COMFY_API_KEY=

# scripts/render_app_examples.py only
# OPENSFIELD_EXAMPLE_VIA=
# OPENSFIELD_FREE_BETWEEN=1
