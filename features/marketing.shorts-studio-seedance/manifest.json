{
  "id": "marketing.shorts-studio-seedance",
  "studio": "Marketing",
  "name": "Shorts studio sessions/presets",
  "tier": "B",
  "base": [
    "planner_llm",
    "ltx25_i2v",
    "tts_audio",
    "stitch"
  ],
  "higgsfield": "shorts_studio_*",
  "track": "partner",
  "note": "Seedance 2.5 through Comfy Cloud API nodes (uses Comfy credits).",
  "count": 1,
  "partner": [
    "api_seedance2_5_i2v_1080p"
  ],
  "status": "built",
  "group": "Shorts studio sessions/presets",
  "default": true,
  "workflow": {
    "template": "api_seedance2_5_t2v_1080p",
    "api": "features/model.seedance2-5-t2v-1080p/workflow_api.json",
    "ui": "features/model.seedance2-5-t2v-1080p/workflow_ui.json",
    "inputs": [
      {
        "name": "style",
        "label": "Short style",
        "kind": "choice",
        "options": [
          "Cinematic story beat",
          "Explainer visual",
          "Hype montage"
        ],
        "default": "Cinematic story beat",
        "presets": {
          "Cinematic story beat": "Vertical short film moment, cinematic lighting, expressive character acting, shallow depth of field.",
          "Explainer visual": "Vertical explainer visual, clean bright scene, one clear subject, smooth camera move, social video look.",
          "Hype montage": "Vertical hype montage shot, rapid camera movement, bold colors, energetic lighting."
        },
        "apply_to": "prompt"
      },
      {
        "name": "prompt",
        "label": "Scene idea",
        "kind": "text",
        "node": "11",
        "field": "model.prompt",
        "required": true
      },
      {
        "name": "resolution",
        "label": "Resolution",
        "kind": "choice",
        "node": "11",
        "field": "model.resolution",
        "options": [
          "480p",
          "720p",
          "1080p"
        ],
        "default": "720p"
      },
      {
        "name": "ratio",
        "label": "Ratio",
        "kind": "choice",
        "node": "11",
        "field": "model.ratio",
        "options": [
          "16:9",
          "4:3",
          "1:1",
          "3:4",
          "9:16",
          "21:9",
          "adaptive"
        ],
        "default": "9:16"
      },
      {
        "name": "duration",
        "label": "Duration",
        "kind": "number",
        "node": "11",
        "field": "model.duration",
        "default": 5,
        "min": 4,
        "max": 30,
        "step": 1
      },
      {
        "name": "seed",
        "label": "Seed (0 = random)",
        "kind": "seed",
        "node": "11",
        "field": "seed",
        "default": 0
      }
    ],
    "outputs": [
      "10"
    ],
    "models": [
      "api_seedance2_5_t2v_1080p"
    ],
    "reuses": "model.seedance2-5-t2v-1080p",
    "output_kind": "video",
    "verified": false
  }
