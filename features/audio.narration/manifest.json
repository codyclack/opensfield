      {
        "name": "seed",
        "label": "Seed (0 = random)",
        "kind": "seed",
        "node": "4",
        "field": "seed",
        "default": 0
      }
    ],
    "outputs": [
      "8"
    ],
    "models": [],
    "reuses": "audio.tts",
    "output_kind": "audio",
    "verified": true,
    "verified_via": "App path: runner.run_comfy -> comfy-sdk -> Comfy Cloud, 2026-10-21",
    "examples": [
      "examples/narration.flac"
    ]
  }
