{
  "id": "marketing.click-to-ad",
  "studio": "Marketing",
  "name": "Product URL -> video ad",
  "tier": "B",
  "base": [
    "planner_llm",
    "ref_edit",
    "ltx25_i2v",
    "tts_audio",
    "stitch"
  ],
  "higgsfield": "Click-to-Ad",
  "track": "open",
  "note": "",
  "count": 1,
  "partner": [],
  "status": "tested",
  "workflow": {
    "template": "video_ltx2_5_i2v",
    "api": "features/cinema.camera-rig/workflow_api.json",
    "ui": "features/cinema.camera-rig/workflow_ui.json",
    "inputs": [
      {
        "name": "start_image",
        "label": "Product image (from your listing)",
        "kind": "image",
        "node": "395",
        "field": "image",
        "required": true
      },
      {
        "name": "style",
        "label": "Ad style",
        "kind": "choice",
        "options": [
          "Punchy 6s spot",
          "Lifestyle spot",
          "Luxury reveal"
        ],
        "default": "Punchy 6s spot",
        "presets": {
          "Punchy 6s spot": "A fast, punchy product ad: dynamic push-in, quick light sweeps, product hero shot on a bold colored backdrop, premium commercial look.",
          "Lifestyle spot": "A warm lifestyle product ad: the product in use in a sunlit home, gentle camera drift, soft focus pulls, commercial look.",
          "Luxury reveal": "A slow luxury product reveal on a dark reflective surface with a sweeping rim light and shallow depth of field."
        },
        "apply_to": "prompt"
      },
      {
        "name": "prompt",
        "label": "Extra detail (optional)",
        "kind": "text",
        "node": "398:376",
        "field": "value",
        "required": false,
        "prefix": "Use the provided start image as the first frame. "
      },
      {
        "name": "aspect",
        "label": "Aspect",
        "kind": "choice",
        "node": "403",
        "field": "aspect_ratio",
        "options": [
          "1:1 (Square)",
          "2:3 (Portrait Photo)",
          "3:2 (Photo)",
          "3:4 (Portrait Standard)",
          "4:3 (Standard)",
          "9:16 (Portrait Widescreen)",
          "16:9 (Widescreen)",
          "21:9 (Ultrawide)"
        ],
        "default": "16:9 (Widescreen)"
      },
      {
        "name": "duration",
        "label": "Duration (s)",
        "kind": "number",
        "node": "398:362",
        "field": "value",
        "default": 5,
        "min": 1,
        "max": 10,
        "step": 1
      },
      {
        "name": "seed",
        "label": "Seed (0 = random)",
        "kind": "seed",
        "node": "398:338",
        "field": "noise_seed",
        "default": 0,
        "also": [
          {
            "node": "398:339",
            "field": "noise_seed"
          }
        ]
      }
    ],
    "outputs": [
      "75"
    ],
    "models": [
      "gemma4-12b-with-proj-ltx-2.5-comfy-int8-convrot.safetensors",
      "gemma4_e2b_it_int8_convrot.safetensors",
      "ltx-2.5-22b-distilled-transformer-comfy-int8-convrot.safetensors",
      "ltx-2.5-audio-vae-bf16.safetensors",
      "ltx-2.5-latent-spatial-upscaler-x2-bf16-1.0.safetensors",
      "ltx-2.5-video-vae-bf16.safetensors",
      "ltx-av-step-1751000_vocoder_24K.safetensors",
      "model.safetensors"
    ],
    "reuses": "cinema.camera-rig",
    "output_kind": "video",
    "verified": true,
    "verified_via": "App path: runner.run_comfy -> comfy-sdk -> Comfy Cloud, 2026-10-21",
    "examples": [
      "examples/click_to_ad.mp4"
    ]
  }
}
