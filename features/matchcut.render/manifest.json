{
  "id": "matchcut.render",
  "studio": "Match Cut + Tracelab",
  "name": "Match-cut reel renderer",
  "tier": "B",
  "base": [
    "stitch",
    "postfx"
  ],
  "higgsfield": "create_render, list_render_modes",
  "track": "open",
  "note": "",
  "count": 1,
  "partner": [],
  "status": "tested",
  "workflow": {
    "local": {
      "mode": "reel"
    },
    "template": "app/fx_tools.py",
    "inputs": [
      {
        "name": "video",
        "label": "Clip 1",
        "kind": "video",
        "required": true
      },
      {
        "name": "video_2",
        "label": "Clip 2",
        "kind": "video",
        "required": true
      },
      {
        "name": "video_3",
        "label": "Clip 3",
        "kind": "video",
        "required": false
      },
      {
        "name": "video_4",
        "label": "Clip 4",
        "kind": "video",
        "required": false
      },
      {
        "name": "look",
        "label": "Render look",
        "kind": "choice",
        "options": [
          "none",
          "black-hot",
          "white-hot",
          "rainbow",
          "iron",
          "crt",
          "crt-glitch",
          "vhs",
          "glitch",
          "nokia",
          "retropop",
          "night-vision"
        ],
        "default": "vhs"
      },
      {
        "name": "bpm",
        "label": "BPM",
        "kind": "number",
        "default": 120,
        "min": 60,
        "max": 180,
        "step": 10
      },
      {
        "name": "ratio",
        "label": "Aspect",
        "kind": "choice",
        "options": [
          "9:16",
          "16:9",
          "1:1",
          "4:5"
        ],
        "default": "9:16"
      }
    ],
    "outputs": [],
    "output_kind": "video",
    "models": [],
    "verified": true,
    "verified_via": "Rendered locally by app/fx.py on CPU, 2026-10-21 (no ComfyUI involved)",
    "examples": [
      "examples/fx_reel_vhs.mp4"
    ]
  }
}
