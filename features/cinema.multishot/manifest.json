{
  "id": "cinema.multishot",
  "studio": "Cinema Studio",
  "name": "Multi-shot sequence + stitch",
  "tier": "A",
  "base": [
    "ltx25_i2v",
    "ltx25_flf2v",
    "stitch"
  ],
  "higgsfield": "cinematic_studio_3_0 / 4_0, nano_banana_2_shots",
  "track": "open",
  "note": "",
  "count": 1,
  "partner": [],
  "status": "tested",
  "workflow": {
    "template": "video_ltx2_5_i2v",
    "api": "features/cinema.camera-rig/workflow_api.json",
    "ui": "features/cinema.camera-rig/workflow_ui.json",
    "inputs": [
      {
        "name": "start_image",
        "label": "Start frame",
        "kind": "image",
        "node": "395",
        "field": "image",
        "required": true
      },
      {
        "name": "prompt",
        "label": "Shots: 'Shot 1: ... Shot 2: ...'",
        "kind": "text",
        "node": "398:376",
        "field": "value",
        "required": true,
        "prefix": "Use the provided start image as the first frame. A multi-shot sequence with hard cuts between shots, consistent character and lighting. "
      },
      {
        "name": "aspect",
        "label": "Aspect",
        "kind": "choice",
        "node": "403",
        "field": "aspect_ratio",
        "options": [
          "1:1 (Square)",
          "2:3 (Portrait Photo)",
          "3:2 (Photo)",
          "3:4 (Portrait Standard)",
          "4:3 (Standard)",
          "9:16 (Portrait Widescreen)",
          "16:9 (Widescreen)",
          "21:9 (Ultrawide)"
        ],
        "default": "16:9 (Widescreen)"
      },
      {
        "name": "duration",
        "label": "Duration (s)",
        "kind": "number",
        "node": "398:362",
        "field": "value",
        "default": 8,
        "min": 1,
        "max": 10,
        "step": 1
      },
      {
        "name": "seed",
        "label": "Seed (0 = random)",
        "kind": "seed",
        "node": "398:338",
        "field": "noise_seed",
        "default": 0,
        "also": [
          {
            "node": "398:339",
            "field": "noise_seed"
          }
        ]
      }
    ],
    "outputs": [
      "75"
    ],
    "models": [
      "gemma4-12b-with-proj-ltx-2.5-comfy-int8-convrot.safetensors",
      "gemma4_e2b_it_int8_convrot.safetensors",
      "ltx-2.5-22b-distilled-transformer-comfy-int8-convrot.safetensors",
      "ltx-2.5-audio-vae-bf16.safetensors",
      "ltx-2.5-latent-spatial-upscaler-x2-bf16-1.0.safetensors",
      "ltx-2.5-video-vae-bf16.safetensors",
      "ltx-av-step-1751000_vocoder_24K.safetensors",
      "model.safetensors"
    ],
    "reuses": "cinema.camera-rig",
    "output_kind": "image",
    "verified": true,
    "verified_via": "Comfy Cloud run_template using the node ids in this map, 2026-10-21 (not yet via comfy-sdk)",
    "examples": [
      "examples/multishot.mp4"
    ]
  }
}
